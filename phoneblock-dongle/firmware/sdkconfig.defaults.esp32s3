# ESP32-S3 overrides, layered by ESP-IDF on top of sdkconfig.defaults
# whenever IDF_TARGET=esp32s3.
#
# Target board: LilyGO T-Dongle-S3 (ESP32-S3, 16 MB flash, no PSRAM).
# Its USB-A plug is wired straight to the chip's built-in
# USB-Serial-JTAG controller — no USB-UART bridge. As on the C3 Super
# Mini (sdkconfig.defaults.esp32c3), USJ must be the primary console so
# the browser installer's Improv provisioning (improv.c) can be read.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 16 MB flash with its own partition table; the shared 4 MB layout would
# leave three quarters of the flash unused for good (the table cannot
# change over the air). See partitions-16mb.csv.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-16mb.csv"
