# Keep dpkg-source's default exclusions (.git, ...) and add the build output
# of the ESP-IDF and host builds. The host test binaries are removed by
# dh_auto_clean (make clean) before the source package is assembled.
tar-ignore
tar-ignore = "firmware/build"
tar-ignore = "firmware/build-*"
tar-ignore = "firmware/managed_components"
tar-ignore = "firmware/sdkconfig"
tar-ignore = "firmware/sdkconfig.old"
tar-ignore = ".gradle"
